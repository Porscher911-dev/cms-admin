generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// -----------------------------------------------------------------------------
// JSON STORE (Replaces localStorage/fs)
// -----------------------------------------------------------------------------
model Store {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// Keeping the original schema for future use
// -----------------------------------------------------------------------------
// USER & RBAC
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatarUrl     String?
  role          String    @default("CLIENT")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  managedClients Client[] @relation("AccountManager")
  tasks          Task[]   @relation("TaskAssignees")
  attendances    Attendance[]
  payrolls       Payroll[]
  approvalsSent  ApprovalRequest[] @relation("Requester")
  approvalsRcvd  ApprovalRequest[] @relation("Approver")
}

// -----------------------------------------------------------------------------
// CRM & SALES
// -----------------------------------------------------------------------------

model Client {
  id            String    @id @default(cuid())
  companyName   String
  contactName   String
  email         String
  phone         String?
  address       String?
  taxCode       String?
  website       String?
  notes         String?
  status        String @default("LEAD")
  
  accountManagerId String?
  accountManager   User?     @relation("AccountManager", fields: [accountManagerId], references: [id])
  
  contracts     Contract[]
  projects      Project[]
  invoices      Invoice[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Contract {
  id            String    @id @default(cuid())
  title         String
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id])
  value         Float
  startDate     DateTime
  endDate       DateTime?
  status        String @default("DRAFT")
  fileUrl       String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// -----------------------------------------------------------------------------
// PROJECT MANAGEMENT
// -----------------------------------------------------------------------------

model Project {
  id            String    @id @default(cuid())
  name          String
  description   String?
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id])
  type          String
  status        String @default("PLANNING")
  startDate     DateTime?
  endDate       DateTime?

  tasks         Task[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Task {
  id            String    @id @default(cuid())
  title         String
  description   String?
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id])
  status        String @default("TODO")
  priority      String   @default("MEDIUM")
  dueDate       DateTime?
  
  assignees     User[]    @relation("TaskAssignees")
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// -----------------------------------------------------------------------------
// HR & FINANCE
// -----------------------------------------------------------------------------

model Attendance {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  date          DateTime
  checkIn       DateTime?
  checkOut      DateTime?
  type          String @default("OFFICE")
  status        String @default("PRESENT")
  ipAddress     String?
  gpsLocation   String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Payroll {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  month         Int
  year          Int
  baseSalary    Float
  allowance     Float     @default(0)
  bonus         Float     @default(0)
  commission    Float     @default(0)
  deduction     Float     @default(0)
  netSalary     Float
  status        String @default("PENDING")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Transaction {
  id            String    @id @default(cuid())
  title         String
  amount        Float
  type          String
  category      String
  date          DateTime  @default(now())
  description   String?
  status        String @default("COMPLETED")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id])
  amount        Float
  issueDate     DateTime
  dueDate       DateTime
  status        String @default("PENDING")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// -----------------------------------------------------------------------------
// APPROVAL WORKFLOW
// -----------------------------------------------------------------------------

model ApprovalRequest {
  id            String    @id @default(cuid())
  title         String
  type          String
  content       String
  status        String @default("PENDING")
  
  requesterId   String
  requester     User      @relation("Requester", fields: [requesterId], references: [id])
  
  approverId    String?
  approver      User?     @relation("Approver", fields: [approverId], references: [id])
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
